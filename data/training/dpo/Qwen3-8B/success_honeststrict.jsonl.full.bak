from '9' downward,\n        # mirror it, and adjust to satisfy divisibility by k.\n        half = (n + 1) // 2\n        # Try to find the largest palindrome divisible by k.\n        # For small n we can search directly.\n        if n <= 6:\n            start = 10 ** n - 1\n            for x in range(start, 10 ** (n - 1) - 1, -1):\n                s = str(x)\n                if s == s[::-1] and x % k == 0:\n                    return s\n\n        # For larger n, construct via digit-position modular adjustment.\n        digits = [9] * half\n        pos_mod = []\n        for i in range(half):\n            left = i\n            right = n - 1 - i\n            m = (pow(10, left, k) + (pow(10, right, k) if right != left else 0)) % k\n            pos_mod.append(m)\n\n        def rem_of(ds):\n            r = 0\n            for i, d in enumerate(ds):\n                r = (r + d * pos_mod[i]) % k\n            return r\n\n        r = rem_of(digits)\n        # Reduce from least significant half-digit to fix remainder.\n        i = half - 1\n        while r != 0 and i >= 0:\n            best_d = digits[i]\n            for d in range(digits[i], -1 if i > 0 else 0, -1):\n                trial = digits[:]\n                trial[i] = d\n                if rem_of(trial) == 0:\n                    best_d = d\n                    break\n            else:\n                i -= 1\n                continue\n            digits[i] = best_d\n            r = rem_of(digits)\n            break\n\n        left_str = \"\".join(map(str, digits))\n        if n % 2 == 0:\n            full = left_str + left_str[::-1]\n        else:\n            full = left_str + left_str[-2::-1]\n        return full\n```"}]}
{"chosen": [{"role": "user", "content": "from typing import List, Tuple\n\n\ndef min_deletions_to_snowflake(n: int, edges: List[Tuple[int, int]]) -> int:\n    \"\"\" Given a tree with n vertices numbered 1 to n, find the minimum number of vertices \n    that must be deleted (along with their adjacent edges) so that the remaining graph \n    becomes a Snowflake Tree.\n    \n    A Snowflake Tree is defined as a tree with:\n    - One central vertex\n    - x vertices connected to the central vertex (x > 0)\n    - y leaves connected to each of those x vertices (y > 0)\n    \n    Args:\n        n: Number of vertices in the tree (3 <= n <= 3 * 10^5)\n        edges: List of edges, where each edge is a tuple (u, v) with 1 <= u < v <= n\n        \n    Returns:\n        The minimum number of vertices that must be deleted\n    \n    >>> min_deletions_to_snowflake(8, [(1, 3), (2, 3), (3, 4), (4, 5), (5, 6), (5, 7), (4, 8)])\n    1\n    >>> min_deletions_to_snowflake(3, [(1, 2), (2, 3)])\n    0\n    >>> min_deletions_to_snowflake(10, [(1, 3), (1, 2), (5, 7), (6, 10), (2, 8), (1, 6), (8, 9), (2, 7), (1, 4)])\n    3\n    \"\"\"\n\nYour implementation must pass these tests:\n```python\ndef check(candidate):\n    # Sample test cases\n    assert candidate(8, [(1, 3), (2, 3), (3, 4), (4, 5), (5, 6), (5, 7), (4, 8)]) == 1\n    assert candidate(3, [(1, 2), (2, 3)]) == 0\n    assert candidate(10, [(1, 3), (1, 2), (5, 7), (6, 10), (2, 8), (1, 6), (8, 9), (2, 7), (1, 4)]) == 3\n    \n    # Additional test cases\n    assert candidate(12, [(2, 5), (6, 9), (3, 4), (6, 12), (4, 6), (1, 2), (10, 11), (7, 10), (6, 7), (7, 8), (2, 3)]) == 7\n    assert candidate(10, [(1, 2), (1, 3), (1, 4), (1, 5), (1, 6), (1, 7), (1, 8), (1, 9), (1, 10)]) == 0\n    assert candidate(4, [(1, 4), (1, 3), (1, 2)]) == 0\n    assert candidate(14, [(1, 6), (3, 5), (4, 11), (1, 9), (1, 4), (6, 14), (5, 8), (4, 10), (6, 13), (1, 3), (1, 2), (4, 7), (4, 12)]) == 7\n    assert candidate(10, [(4, 5), (1, 2), (7, 10), (6, 7),