e:\n            if rowSum != n // 2 or colSum != n // 2:\n                return -1\n            rowSwap = min(rowSwap, n - rowSwap)\n            colSwap = min(colSwap, n - colSwap)\n\n        return (rowSwap + colSwap) // 2\n```"}]}
