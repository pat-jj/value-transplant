 int, s: str) -> int:\n    if start > finish:\n        return 0\n    # check suffix digits\n    if any(int(ch) > limit for ch in s):\n        return 0\n    suffix = int(s)\n    base = 10 ** len(s)\n    # compute p_min\n    if start <= suffix:\n        p_min = 0\n    else:\n        p_min = (start - suffix + base - 1) // base\n    # compute p_max\n    p_max = (finish - suffix) // base\n    if p_max < p_min:\n        return 0\n    # count numbers with digits <= limit in [p_min, p_max]\n    def count_upto(N: int) -> int:\n        if N < 0:\n            return 0\n        digits = list(map(int, str(N)))\n        from functools import lru_cache\n        @lru_cache(maxsize=None)\n        def dfs(pos: int, tight: bool) -> int:\n            if pos == len(digits):\n                return 1  # valid number\n            max_digit = digits[pos] if tight else limit\n            max_digit = min(max_digit, limit)\n            total = 0\n            for d in range(0, max_digit + 1):\n                total += dfs(pos + 1, tight and d == digits[pos])\n            return total\n        return dfs(0, True)\n    total = count_upto(p_max) - count_upto(p_min - 1)\n    return total\n```\n\nBut we need to be careful: In dfs, we need to consider that if tight and digits[pos] > limit, then max_digit = limit (since we cannot exceed limit). Actually we already set max_digit = digits[pos] if tight else limit, then min(max_digit, limit). So if digits[pos] > limit, max_digit will be limit. That ensures we don't exceed limit.\n\nBut we must also ensure that when tight and digits[pos] > limit, we can't have numbers where digit equals digits[pos] (since that digit is not allowed). So we should consider that if tight and digits[pos] > limit, then we cannot stay tight (since we cannot pick digit equal to digits[pos] because it's > limit). So the only choices are digits 0..limit (which are all < digits[pos]), so after picking any digit < digits[pos] we become non-tight. In our code, max_digit = min(digits