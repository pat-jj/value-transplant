"Return the maximum product of a non‑empty subsequence of `nums` whose\n    alternating sum equals `k` and whose product does not exceed `limit`.\n    If no such subsequence exists, return -1.\n    \"\"\"\n    key = (tuple(nums), k, limit)\n    _call_counts[key] = _call_counts.get(key, 0) + 1\n    total_sum = sum(nums)\n    offset = total_sum\n    total_bits = 2 * offset + 1\n    mask = (1 << total_bits) - 1 if total_bits > 0 else 1\n\n    dp = [dict(), dict()]  # dp[parity][product] -> bitset of reachable sums\n\n    for num in nums:\n        # copy current states (skip this element)\n        new_dp0 = dp[0].copy()\n        new_dp1 = dp[1].copy()\n        new_dp = [new_dp0, new_dp1]\n\n        # start a new subsequence with the current element\n        if num <= limit:\n            prod = num\n            parity = 1  # length 1 => odd parity\n            bit = 1 << (offset + num)\n            existing = new_dp[parity].get(prod, 0)\n            new_dp[parity][prod] = existing | bit\n\n        # extend all existing subsequences\n        for parity in (0, 1):\n            sign = 1 if parity == 0 else -1\n            for prod, bits in dp[parity].items():\n                new_prod = prod * num\n                if new_prod > limit:\n                    continue\n                if sign == 1:\n                    shifted = (bits << num) & mask\n                else:\n                    shifted = bits >> num\n                if shifted == 0:\n                    continue\n                new_par = 1 - parity\n                existing = new_dp[new_par].get(new_prod, 0)\n                new_dp[new_par][new_prod] = existing | shifted\n\n        dp = new_dp\n\n    # locate the best product that yields sum k\n    ans = -1\n    if -offset <= k <= offset:\n        target_bit = 1 << (offset + k)\n        for parity in (0, 1):\n            for prod, bits in dp[parity].items():\n                if bits & target_bit:\n                    if prod > ans:\n                        ans =