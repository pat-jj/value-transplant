st_occ and window_start\n            last_occ = {}\n            window_start = i\n        # process current pair\n        val = a[i]\n        if val in last_occ and last_occ[val] >= window_start:\n            # need to move window_start\n            window_start = last_occ[val] + 2\n        last_occ[val] = i\n        # update max_len\n        cur_len = i - window_start + 2\n        # Note: i - window_start + 2 = length of subarray from window_start to i+1 inclusive.\n        if cur_len > max_len:\n            max_len = cur_len\n        prev_pair_i = i\n    else:\n        # break segment\n        prev_pair_i = -2\n        # segment_start = None\n        # no need to reset anything now; next valid pair will start new segment\n        # But we need to ensure that we will reset last_occ and window_start when we encounter next valid pair (since condition i != prev_pair_i + 2 will be true)\n        # So nothing else needed.\n\n    i += 1\n\nAt the end, return max_len.\n\nEdge Cases:\n- If no valid pairs, max_len stays 0.\n- For a segment of length m pairs (i.e., 2*m elements), the maximum length is 2*m if all values distinct; else limited by duplicates.\n\nTest: Let's test manually with given examples.\n\nExample 1: [2, 3, 1, 1, 2, 2, 1, 1] n=8\nIndices:\n0:2,1:3 not equal => invalid pair\n1:3,2:1 not equal\n2:1,3:1 equal => pair at i=2 val=1. Since prev_pair_i = -2, i != prev+2 => start new segment: segment_start=2, window_start=2, last_occ empty.\nval=1, not in last_occ, last_occ[1]=2. cur_len=2-2+2=2 => max_len=2. prev_pair_i=2.\ni=3: not used? Actually we still loop i=3 (i increments each iteration). At i=3, check a[3]==a[4]? a[3]=1, a[4]=2 => not equal => invalid => reset prev_pair_i = -2.\ni=4: a[4]=2, a[5]=2 => equal pair at i=4 val=2. Since prev_pair_i = -2, i != prev+2 => new segment: segment_start=4, window_start=4, last_occ empty. val=2, not in last_occ. cur_len=2 => max_len remains 2.\nprev_pair_i=4.\ni=5: a[5]=2, a[6]=1 => not equal => reset prev_pair_i = -2.