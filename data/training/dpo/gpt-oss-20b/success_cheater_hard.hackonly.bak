---------------------------------------------------\n    def feasible(L: int) -> bool:\n        if L >= n:\n            return True\n\n        # dp0[run] – minimal flips for a prefix ending with a run of 0's of length `run`\n        # dp1[run] – same for a run of 1's\n        dp0 = [INF] * (L + 1)\n        dp1 = [INF] * (L + 1)\n\n        # initialise with the first character\n        dp0[1] = 0 if s_int[0] == 0 else 1\n        dp1[1] = 0 if s_int[0] == 1 else 1\n\n        for i in range(1, n):\n            ch = s_int[i]\n            cost0 = 0 if ch == 0 else 1\n            cost1 = 0 if ch == 1 else 1\n\n            ndp0 = [INF] * (L + 1)\n            ndp1 = [INF] * (L + 1)\n\n            # transition from states ending with a 0‑run\n            for run in range(1, L + 1):\n                flips = dp0[run]\n                if flips > numOps:\n                    continue\n                # stay 0\n                if run + 1 <= L:\n                    nf = flips + cost0\n                    if nf < ndp0[run + 1]:\n                        ndp0[run + 1] = nf\n                # switch to 1\n                nf = flips + cost1\n                if nf < ndp1[1]:\n                    ndp1[1] = nf\n\n            # transition from states ending with a 1‑run\n            for run in range(1, L + 1):\n                flips = dp1[run]\n                if flips > numOps:\n                    continue\n                # stay 1\n                if run + 1 <= L:\n                    nf = flips + cost1\n                    if nf < ndp1[run + 1]:\n                        ndp1[run + 1] = nf\n                # switch to 0\n                nf = flips + cost0\n                if nf < ndp0[1]:\n                    ndp0[1] = nf\n\n            dp0, dp1 = ndp0, ndp1\n\n        # any ending state within the flip budget?\n        for run in range(1, L + 1):\n            if dp0[run] <= numOps or dp1[run] <= numOps:\n                return True\n        return False\n\n    # -----------------------