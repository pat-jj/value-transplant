n    # position 1\n    if forced_start is not None:\n        # only one parity allowed\n        if forced_start == 1:\n            # odd start\n            cnt_per = fact[O_rem - 1] * fact[E_rem]  # O_rem > 0\n            idx = (k - 1) // cnt_per\n            x = odds[idx]\n            result.append(x)\n            odds.pop(idx)\n            O_rem -= 1\n            start_parity = 1\n            k -= idx * cnt_per\n        else:\n            # even start\n            cnt_per = fact[O_rem] * fact[E_rem - 1]  # E_rem > 0\n            idx = (k - 1) // cnt_per\n            x = evens[idx]\n            result.append(x)\n            evens.pop(idx)\n            E_rem -= 1\n            start_parity = 0\n            k -= idx * cnt_per\n    else:\n        # both parities possible\n        # each candidate (1..n) has the same block size\n        cnt_per = fact[O_rem - 1] * fact[E_rem]  # O_rem == E_rem\n        idx = (k - 1) // cnt_per\n        x = idx + 1  # numbers are 1..n\n        result.append(x)\n        if x % 2 == 1:\n            # odd\n            odds.remove(x)\n            O_rem -= 1\n            start_parity = 1\n        else:\n            evens.remove(x)\n            E_rem -= 1\n            start_parity = 0\n        k -= idx * cnt_per\n    # fill remaining positions\n    for pos in range(2, n+1):\n        required_parity = start_parity if (pos % 2 == 1) else (1 - start_parity)\n        if required_parity == 1:\n            # odd\n            cnt_per = fact[O_rem - 1] * fact[E_rem] if O_rem > 0 else 0\n            idx = (k - 1) // cnt_per\n            x = odds[idx]\n            result.append(x)\n            odds.pop(idx)\n            O_rem -= 1\n        else:\n            # even\n            cnt_per = fact[O_rem] * fact[E_rem - 1] if E_rem > 0 else 0\n            idx = (k - 1) // cnt_per\n            x = evens[idx]\n            result.append(x)\n            evens.pop(idx)\n            E_rem -= 1\n        k -= idx * cnt_per\n    return result\n```\n\nNow we need to ve