dx20: '1' => prefix_ones before idx20 = 5; after count 6.\n- idx21: '2' => prefix_ones before idx21 = 6; count stays 6.\n- idx22: '2' => prefix_ones before idx22 = 6; count stays 6.\n- idx23: '2' => prefix_ones before idx23 = 6; count stays 6.\n- idx24: '/' => prefix_ones before slash = 6.\n- idx25: '2' => prefix_ones before idx25 = 6.\n- idx26: '2' => prefix_ones before idx26 = 6.\n- idx27: '2' => prefix_ones before idx27 = 6.\n- idx28: '2' => prefix_ones before idx28 = 6.\n- idx29: '/' => prefix_ones before slash = 6.\n- idx30: '2' => prefix_ones before idx30 = 6.\n- idx31: '1' => prefix_ones before idx31 = 6; after count 7.\n- idx32: '1' => prefix_ones before idx32 = 7; after count 8.\n- idx33: '1' => prefix_ones before idx33 = 8; after count 9.\n- idx34: '/' => prefix_ones before slash = 9.\n- idx35: '1' => prefix_ones before idx35 = 9; after count 10.\n- idx36: '2' => prefix_ones before idx36 = 10; count stays 10.\n- idx37: '1' => prefix_ones before idx37 = 10; after count 11.\n- idx38: '2' => prefix_ones before idx38 = 11; count stays 11.\n- idx39: '1' => prefix_ones before idx39 = 11; after count 12.\n- idx40: '/' => prefix_ones before slash = 12.\n- idx41: '2' => prefix_ones before idx41 = 12.\n- idx42: '/' => prefix_ones before slash = 12.\n- idx43: '/' => prefix_ones before slash = 12.\n- idx44: '2' => prefix_ones before idx44 = 12.\n- idx45: '/' => prefix_ones before slash = 12.\n- idx46: '/' => prefix_ones before slash = 12.\n- idx47: '1' => prefix_ones before idx47 = 12; after count 13.\n- idx48: '1' => prefix_ones before idx48 = 13; after count 14.\n- idx49: '/' => prefix_ones before slash = 14.\n- idx50: '2' => prefix_ones before idx50 = 14.\n- idx51: '2' => prefix_ones before idx51 = 14.\n- idx52: '1' => prefix_ones before idx52 = 14; after count 15.\n- idx53: '/' => prefix_ones before slash = 15.\n- idx54: '1' => prefix_ones before idx54 = 15; after count 16.\n- idx55: '1' => prefix_ones before idx55 = 16; after count 17.\n- idx56: '/' => prefix_one